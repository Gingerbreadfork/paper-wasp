{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Wasp",
  "version": "0.1.0",
  "identifier": "dev.paperwasp.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paper Wasp",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#e9e8e3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' wasp: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "A PDF reader that doesn't trust the document.",
    "longDescription": "Paper Wasp renders every PDF to plain pixels inside a locked-down worker process. Scripts never run, links stay inert, and the file never touches the interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "./paper-wasp.desktop.hbs"
      },
      "rpm": {
        "depends": [],
        "desktopTemplate": "./paper-wasp.desktop.hbs"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer"
      }
    ]
  }
}
